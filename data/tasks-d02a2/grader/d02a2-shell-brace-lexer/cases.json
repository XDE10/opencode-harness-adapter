{
  "function": "tokenize_command",
  "cases": [
    {
      "id": "basic_interp_and_brace",
      "args": [
        "echo \"hi $USER\" {a,b}.txt",
        {
          "USER": "ada"
        }
      ],
      "value": [
        "echo",
        "hi ada",
        "a.txt",
        "b.txt"
      ]
    },
    {
      "id": "single_quotes_and_escapes",
      "args": [
        "grep '$USER' a\\ b\\{c,d\\} ${EXT}_file",
        {
          "USER": "bob",
          "EXT": "py"
        }
      ],
      "value": [
        "grep",
        "$USER",
        "a b{c,d}",
        "py_file"
      ]
    },
    {
      "id": "brace_no_comma_and_empty_alt",
      "args": [
        "run {solo} pre{1,,3}post $",
        {}
      ],
      "value": [
        "run",
        "{solo}",
        "pre1post",
        "prepost",
        "pre3post",
        "$"
      ]
    },
    {
      "id": "double_quoted_braces_not_expanded",
      "args": [
        "cmd \"{a,b}\" pre\"{x,y}\"post",
        {}
      ],
      "value": [
        "cmd",
        "{a,b}",
        "pre{x,y}post"
      ]
    },
    {
      "id": "double_quoted_comma_inside_braces",
      "args": [
        "item{1,\"2,3\",4}",
        {}
      ],
      "value": [
        "item1",
        "item2,3",
        "item4"
      ]
    },
    {
      "id": "empty_quoted_tokens",
      "args": [
        "cmd \"\" '' \"\"$EMPTY",
        {}
      ],
      "value": [
        "cmd",
        "",
        "",
        ""
      ]
    },
    {
      "id": "unexpanded_empty_var_standalone",
      "args": [
        "a $MISSING b",
        {}
      ],
      "value": [
        "a",
        "",
        "b"
      ]
    },
    {
      "id": "error_unclosed_quote",
      "args": [
        "echo \"hello\\\"",
        {}
      ],
      "raises": "ValueError"
    },
    {
      "id": "error_invalid_var_syntax",
      "args": [
        "echo ${123}",
        {}
      ],
      "raises": "ValueError"
    }
  ]
}
