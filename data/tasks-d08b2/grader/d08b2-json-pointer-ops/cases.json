          {
            "op": "set",
            "path": "/xs/1",
            "value": 9
          },
          {
            "op": "get",
            "path": "/xs"
          }
        ]
      ],
      "value": {
        "results": [
          null,
          null,
          [
            1,
            9,
            3
          ]
        ],
        "doc": {
          "xs": [
            1,
            9,
            3
          ]
        }
      }
    },
    {
