{
  "function": "run_pointer",
  "cases": [
    {
      "id": "basic_root_get_set",
      "args": [
        {
          "a": 1,
          "b": [
            10,
            20
          ]
        },
        [
          {
            "op": "get",
            "path": ""
          },
          {
            "op": "set",
            "path": "/a",
            "value": 9
          },
          {
            "op": "get",
            "path": "/a"
          },
          {
            "op": "get",
            "path": "/b/1"
          }
        ]
      ],
      "value": {
        "results": [
          {
            "a": 1,
            "b": [
              10,
              20
            ]
          },
          null,
          9,
          20
        ],
        "doc": {
          "a": 9,
          "b": [
            10,
            20
          ]
        }
      }
    },
    {
      "id": "escaped_keys",
      "args": [
        {
          "a/b": 1,
          "m~n": 2,
          "": 3
        },
        [
          {
            "op": "get",
            "path": "/a~1b"
          },
          {
            "op": "get",
            "path": "/m~0n"
          },
          {
            "op": "get",
            "path": "/"
          }
        ]
      ],
      "value": {
        "results": [
          1,
          2,
          3
        ],
        "doc": {
          "a/b": 1,
          "m~n": 2,
          "": 3
        }
      }
    },
    {
