          {
            "op": "get",
            "path": "/x"
          },
          {
            "op": "remove",
            "path": "/arr/0"
          },
          {
            "op": "get",
            "path": "/arr"
          }
        ]
      ],
      "value": {
        "results": [
          null,
          {},
          null,
          [
            8
          ]
        ],
        "doc": {
          "x": {},
          "arr": [
            8
          ]
        }
      }
    },
    {
