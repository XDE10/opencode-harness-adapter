    {"id": "explicit_destination", "args": [{"msg": "raw", "message": null}, {"msg": "message"}], "value": {"message": null}},
    {"id": "absent_source", "args": [{"a": 3, "b": 0}, {"x": "a", "b": "c"}], "value": {"a": 3, "c": 0}},
