{
  "id": "oca-v5",
  "model": {
    "id": "Qwen/Qwen3.5-9B",
    "local_path": "",
    "served_name": "qwen35-9b",
    "tool_call_parser": "qwen3_coder"
  },
  "opencode": {
    "version": "2.2.7",
    "bin": "",
    "permission": {
      "*": "deny",
      "read": "allow",
      "edit": "allow",
      "write": "allow",
      "list": "allow",
      "glob": "allow",
      "grep": "allow",
      "bash": "allow"
    }
  },
  "pi": {
    "package": "@earendil-works/pi-coding-agent",
    "bin": "",
    "tools": "read,write,edit,bash"
  },
  "rollout": {
    "temperature": 0.8,
    "top_p": 1.0,
    "enable_thinking": false,
    "max_context_tokens": 32768,
    "max_output_tokens_per_call": 2048,
    "max_output_tokens_per_trial": 10240,
    "max_model_calls": 24,
    "timeout_seconds": 300,
    "concurrency": 48,
    "workdir_root": "",
    "safe_intercept": true,
    "use_bwrap": true
  },
  "grade": {
    "timeout_seconds": 60
  },
  "train": {
    "group_size": 4,
    "tasks_per_step": 6,
    "oversample_factor": 1.5,
    "early_cutoff": true,
    "steps": 50,
    "rank": 32,
    "alpha": 64,
    "max_lora_rank": 64,
    "lora_init_seed": 2026,
    "targets": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
    "deltanet_targets": ["in_proj_qkv", "in_proj_z", "in_proj_b", "in_proj_a", "out_proj"],
    "use_deltanet_lora": true,
    "lr": 2e-5,
    "adv_mode": "dr_grpo",
    "filter_same_correctness": true,
    "loss_mode": "tis_clip",
    "credit_mode": "outcome",
    "turn_credit_weight": 0.2,
    "norm_mode": "token",
    "prefix_merge": true,
    "clip_low": 0.2,
    "clip_high": 0.28,
    "gspo_clip_low": 0.003,
    "gspo_clip_high": 0.004,
    "cispo_clip_low": 0.2,
    "cispo_clip_high": 0.28,
    "max_grad_norm": 1.0,
    "minibatches": 2,
    "tis_cap": 2.0,
    "efficiency_weight": 0.05,
    "efficiency_budget": 24,
    "efficiency_token_budget": 8192,
    "lm_head_chunk_size": 2048,
    "vllm_gpu_memory_utilization": 0.70,
    "vllm_max_num_seqs": 64,
    "vllm_max_num_batched_tokens": 16384
  }
}
